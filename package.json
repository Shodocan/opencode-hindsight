{
  "name": "opencode-hindsight",
  "version": "1.0.0",
  "description": "OpenCode plugin that gives coding agents persistent memory using Hindsight",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "opencode-hindsight": "./dist/cli.js"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node && bun build ./src/cli.ts --outfile ./dist/cli.js --target node && tsc --emitDeclarationOnly",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "keywords": [
    "opencode",
    "plugin",
    "hindsight",
    "memory",
    "ai",
    "coding-agent"
  ],
  "author": "OpenCode Community",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/opencode-community/opencode-hindsight"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.0.162",
    "@vectorize-io/hindsight-client": "0.6.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.3"
  },
  "opencode": {
    "type": "plugin",
    "hooks": [
      "chat.message",
      "event"
    ]
  },
  "files": [
    "dist"
  ]
}